# Server Environment Variables Template
# Copy this to .env and fill in your values

NODE_ENV=production
PORT=3001

# MongoDB Connection
MONGODB_URI=mongodb+srv://teenpatti_admin:<db_password>@cluster0.3rtayk3.mongodb.net/?appName=Cluster0
DB_NAME=cluster0

# Frontend URL (your deployed client URL)
CLIENT_URL=https://teen-patti-react.vercel.app/
ALLOWED_ORIGINS=https://teen-patti-react.vercel.app/
SOCKET_CORS_ORIGIN=https://teen-patti-react.vercel.app/

# Security
SESSION_SECRET=your-random-secret-key-minimum-32-characters
JWT_SECRET=another-random-secret-key-minimum-32-characters

# Game Configuration
MAX_PLAYERS_PER_TABLE=5
