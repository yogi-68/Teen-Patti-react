# Server Environment Variables Template
# Copy this to .env and fill in your values

NODE_ENV=production
PORT=3001

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/teenpatti
DB_NAME=teenpatti

# Frontend URL (your deployed client URL)
CLIENT_URL=https://your-frontend.vercel.app
ALLOWED_ORIGINS=https://your-frontend.vercel.app
SOCKET_CORS_ORIGIN=https://your-frontend.vercel.app

# Security
SESSION_SECRET=your-random-secret-key-minimum-32-characters
JWT_SECRET=another-random-secret-key-minimum-32-characters

# Game Configuration
MAX_PLAYERS_PER_TABLE=5
