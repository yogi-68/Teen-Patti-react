{
  "name": "teen-patti-server",
  "version": "1.0.0",
  "description": "Modern Teen Patti game server with TypeScript",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "create-admin": "tsx src/scripts/createAdmin.ts",
    "verify-bots": "tsx src/scripts/verifyBotSystem.ts"
  },
  "keywords": [
    "teen-patti",
    "card-game",
    "poker",
    "multiplayer",
    "socket.io"
  ],
  "author": "yogi-68",
  "license": "MIT",
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.7.0",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "mongodb": "^6.9.0",
    "mongoose": "^8.19.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "socket.io": "^4.7.5",
    "typescript": "^5.6.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.11.1",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^10.3.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.19.1"
  }
}
